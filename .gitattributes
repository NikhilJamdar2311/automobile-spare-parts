# Auto detect text files
* text=auto

# JavaScript / React
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# CSS
*.css text eol=lf

# Markdown
*.md text eol=lf

# HTML
*.html text eol=lf

# Environment Files
*.env text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary